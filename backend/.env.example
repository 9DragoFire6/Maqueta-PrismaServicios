# Copia este archivo a ".env" y completa los valores. Todo apunta a localhost:
# este proyecto es solo para correr en tu maquina, no hay despliegue.
#
# IMPORTANTE: al copiar este archivo, SECRET_KEY y FIELD_ENCRYPTION_KEY quedan
# vacios a proposito (son secretos, nunca se versionan). No son opcionales:
# el proyecto no arranca sin generarlos primero (ver el comentario de cada
# uno mas abajo). Edita el archivo .env con cualquier editor de texto
# (Bloc de notas, VS Code, etc.), pegando el resultado de cada comando en una
# sola linea, sin comillas.

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Nombre de empresa que aparece en el PDF de contrato.
EMPRESA_NOMBRE=Prisma Servicios

# Postgres local. IMPORTANTE: antes de correr "manage.py migrate" necesitas
# tener PostgreSQL instalado y corriendo en tu maquina, y la base de datos de
# abajo (DB_NAME) ya creada a mano -- migrate crea las tablas, no el servidor
# ni la base en si (ver el README para como instalar Postgres y crearla).
DB_NAME=gestion_servicios
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave para los campos cifrados (datos personales). Genera una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
