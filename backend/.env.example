# Copia este archivo a ".env" y completa los valores. Todo apunta a localhost:
# este proyecto es solo para correr en tu maquina, no hay despliegue.

# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres local (crea la base a mano antes de correr las migraciones, ver README).
DB_NAME=gestion_servicios
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Clave para los campos cifrados (datos personales). Genera una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
